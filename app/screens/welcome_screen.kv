#:kivy 2.3.1

<WelcomeScreen>:
    canvas.before:
        Color:
            rgba: 0.4, 0.75, 0.45, 1  # Color verde principal
        Rectangle:
            pos: self.pos
            size: self.size
    
    # Elementos decorativos circulares
    FloatLayout:
        # Círculo grande superior derecha
        Widget:
            size_hint: None, None
            size: 180, 180
            pos_hint: {'x': 0.55, 'y': 0.72}
            canvas:
                Color:
                    rgba: 0.45, 0.8, 0.5, 0.3
                Ellipse:
                    pos: self.pos
                    size: self.size
        
        # Círculo pequeño izquierda
        Widget:
            size_hint: None, None
            size: 40, 40
            pos_hint: {'x': 0.08, 'y': 0.55}
            canvas:
                Color:
                    rgba: 1, 1, 1, 0.25
                Ellipse:
                    pos: self.pos
                    size: self.size
        
        # Círculo pequeño derecha inferior
        Widget:
            size_hint: None, None
            size: 35, 35
            pos_hint: {'x': 0.82, 'y': 0.18}
            canvas:
                Color:
                    rgba: 1, 1, 1, 0.2
                Ellipse:
                    pos: self.pos
                    size: self.size
        
        # Círculo mediano superior derecha
        Widget:
            size_hint: None, None
            size: 60, 60
            pos_hint: {'x': 0.76, 'y': 0.82}
            canvas:
                Color:
                    rgba: 1, 1, 1, 0.35
                Ellipse:
                    pos: self.pos
                    size: self.size
        
        # Icono sol (líneas)
        Widget:
            size_hint: None, None
            size: 25, 25
            pos_hint: {'x': 0.85, 'y': 0.92}
            canvas:
                Color:
                    rgba: 1, 1, 1, 0.6
                Line:
                    points: [self.center_x, self.y, self.center_x, self.y + 8]
                    width: 1.5
                Line:
                    points: [self.center_x, self.top - 8, self.center_x, self.top]
                    width: 1.5
                Line:
                    points: [self.x, self.center_y, self.x + 8, self.center_y]
                    width: 1.5
                Line:
                    points: [self.right - 8, self.center_y, self.right, self.center_y]
                    width: 1.5
                Ellipse:
                    pos: self.center_x - 5, self.center_y - 5
                    size: 10, 10
        
        # Icono hoja superior derecha
        Widget:
            size_hint: None, None
            size: 35, 35
            pos_hint: {'x': 0.8, 'y': 0.75}
            canvas:
                Color:
                    rgba: 1, 1, 1, 0.5
                Ellipse:
                    pos: self.center_x - 12, self.center_y - 8
                    size: 15, 20
                    angle_start: 0
                    angle_end: 180
                Line:
                    points: [self.center_x, self.center_y - 8, self.center_x, self.center_y + 8]
                    width: 1.5
        
        # Contenido principal
        BoxLayout:
            orientation: 'vertical'
            padding: 30
            spacing: 20
            pos_hint: {'center_x': 0.5, 'center_y': 0.5}
            
            # Espaciador superior
            Widget:
                size_hint_y: 0.25
            
            # Logo circular con icono de reciclaje
            FloatLayout:
                size_hint_y: None
                height: 140
                
                Widget:
                    size_hint: None, None
                    size: 140, 140
                    pos_hint: {'center_x': 0.5, 'center_y': 0.5}
                    canvas:
                        Color:
                            rgba: 1, 1, 1, 1
                        Ellipse:
                            pos: self.pos
                            size: self.size
                
                # Símbolo de reciclaje
                Label:
                    text: '♻'
                    font_size: '60sp'
                    color: 0.4, 0.75, 0.45, 1
                    pos_hint: {'center_x': 0.5, 'center_y': 0.5}
            
            # Título
            Label:
                text: 'Reciclapp'
                font_size: '38sp'
                bold: True
                color: 1, 1, 1, 1
                size_hint_y: None
                height: 50
            
            # Subtítulo
            Label:
                text: 'Tu aliado para un futuro sostenible'
                font_size: '16sp'
                color: 1, 1, 1, 0.95
                size_hint_y: None
                height: 30
            
            # Espaciador
            Widget:
                size_hint_y: 0.15
            
            # Lista de características
            BoxLayout:
                orientation: 'vertical'
                spacing: 15
                size_hint_y: None
                height: 140
                padding: [20, 0]
                
                # Característica 1
                BoxLayout:
                    size_hint_y: None
                    height: 40
                    spacing: 15
                    
                    Widget:
                        size_hint_x: None
                        width: 35
                        canvas:
                            Color:
                                rgba: 1, 1, 1, 0.35
                            RoundedRectangle:
                                pos: self.pos
                                size: self.size
                                radius: [8]
                        
                        Label:
                            text: '♻'
                            font_size: '20sp'
                            color: 1, 1, 1, 1
                            pos_hint: {'center_x': 0.5, 'center_y': 0.5}
                    
                    Label:
                        text: 'Recicla y gana EcoTokens'
                        font_size: '15sp'
                        color: 1, 1, 1, 1
                        text_size: self.size
                        halign: 'left'
                        valign: 'middle'
                
                # Característica 2
                BoxLayout:
                    size_hint_y: None
                    height: 40
                    spacing: 15
                    
                    Widget:
                        size_hint_x: None
                        width: 35
                        canvas:
                            Color:
                                rgba: 1, 1, 1, 0.35
                            RoundedRectangle:
                                pos: self.pos
                                size: self.size
                                radius: [8]
                        
                        Label:
                            text: '🍃'
                            font_size: '20sp'
                            color: 1, 1, 1, 1
                            pos_hint: {'center_x': 0.5, 'center_y': 0.5}
                    
                    Label:
                        text: 'Encuentra puntos de reciclaje cercanos'
                        font_size: '15sp'
                        color: 1, 1, 1, 1
                        text_size: self.size
                        halign: 'left'
                        valign: 'middle'
                
                # Característica 3
                BoxLayout:
                    size_hint_y: None
                    height: 40
                    spacing: 15
                    
                    Widget:
                        size_hint_x: None
                        width: 35
                        canvas:
                            Color:
                                rgba: 1, 1, 1, 0.35
                            RoundedRectangle:
                                pos: self.pos
                                size: self.size
                                radius: [8]
                        
                        Label:
                            text: '△'
                            font_size: '20sp'
                            color: 1, 1, 1, 1
                            pos_hint: {'center_x': 0.5, 'center_y': 0.5}
                    
                    Label:
                        text: 'Mide tu impacto ambiental'
                        font_size: '15sp'
                        color: 1, 1, 1, 1
                        text_size: self.size
                        halign: 'left'
                        valign: 'middle'
            
            # Espaciador
            Widget:
                size_hint_y: 0.12
            
            # Botón Comenzar
            Button:
                text: 'Comenzar'
                size_hint_y: None
                height: 55
                background_normal: ''
                background_color: 1, 1, 1, 1
                color: 0.4, 0.75, 0.45, 1
                font_size: '18sp'
                bold: True
                on_press: root.comenzar()
                canvas.before:
                    Color:
                        rgba: 1, 1, 1, 1
                    RoundedRectangle:
                        pos: self.pos
                        size: self.size
                        radius: [12]
            
            # Texto inferior
            Label:
                text: 'Únete a miles de usuarios comprometidos con el medio\nambiente'
                font_size: '12sp'
                color: 1, 1, 1, 0.8
                size_hint_y: None
                height: 40
                halign: 'center'
            
            # Espaciador inferior
            Widget:
                size_hint_y: 0.08

