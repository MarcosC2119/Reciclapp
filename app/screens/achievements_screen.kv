#:kivy 2.3.1
#:import utils kivy.utils
#:import NoTransition kivy.uix.screenmanager.NoTransition
#:import MDIcon kivymd.uix.label.MDIcon

# --- Widget Personalizado: Item de Logro ---
<AchievementItem@BoxLayout>:
    size_hint_y: None
    height: dp(100)
    padding: dp(15)
    icon_text: ''
    title_text: ''
    rarity_text: ''
    rarity_color: (1,1,1,1)
    description_text: ''
    points_text: ''
    date_text: ''
    locked: False
    
    canvas.before:
        Color:
            rgba: (1,1,1,1) if not root.locked else utils.get_color_from_hex('#fafafa')
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [dp(20)]
        Color:
            rgba: (.8, .8, .8, .5) if root.locked else (0,0,0,0)
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [dp(20)]

    # Icono
    BoxLayout:
        size_hint_x: None
        width: dp(60)
        canvas.before:
            Color:
                rgba: utils.get_color_from_hex('#e8f5e9') if not root.locked else utils.get_color_from_hex('#eeeeee')
            Ellipse:
                pos: self.center_x - dp(25), self.center_y - dp(25)
                size: dp(50), dp(50)
        MDIcon:
            icon: root.icon_text
            theme_text_color: "Custom"
            text_color: utils.get_color_from_hex('#4caf50') if not root.locked else (.7,.7,.7,1)
            font_size: '24sp'
            pos_hint: {'center_x': .5, 'center_y': .5}
            halign: "center"
    
    # Contenido
    BoxLayout:
        orientation: 'vertical'
        padding: [dp(10), 0]
        spacing: dp(5)
        BoxLayout:
            size_hint_y: None
            height: dp(25)
            Label:
                text: root.title_text
                font_size: '16sp'
                bold: True
                color: (.2,.2,.2,1) if not root.locked else (.6,.6,.6,1)
                halign: 'left'
                text_size: self.width, None
            Label:
                text: root.rarity_text
                size_hint: None, None
                size: self.texture_size[0] + dp(20), dp(25)
                color: root.rarity_color if not root.locked else (.6,.6,.6,1)
                canvas.before:
                    Color:
                        rgba: utils.get_color_from_hex('#eeeeee') if root.locked else utils.get_color_from_hex('#f5f5f5')
                    RoundedRectangle:
                        pos: self.pos
                        size: self.size
                        radius: [dp(12)]
        Label:
            text: root.description_text
            font_size: '13sp'
            color: (.5,.5,.5,1) if not root.locked else (.7,.7,.7,1)
            halign: 'left'
            text_size: self.width, None
        
        BoxLayout:
            size_hint_y: None
            height: dp(20)
            Label:
                text: root.points_text
                font_size: '13sp'
                bold: True
                color: utils.get_color_from_hex('#ff9800') if not root.locked else (.7,.7,.7,1)
                halign: 'left'
                text_size: self.width, None
            Label:
                text: root.date_text
                font_size: '13sp'
                color: (.6,.6,.6,1) if not root.locked else (.7,.7,.7,1)
                halign: 'left'
                text_size: self.width, None

# --- Widget Personalizado: Item de Ranking ---
<RankingItem@BoxLayout>:
    size_hint_y: None
    height: dp(70)
    padding: [dp(10), 0]
    rank_text: '0'
    avatar_text: 'U'
    avatar_color: (1,1,1,1)
    name_text: 'Usuario'
    points_text: '0 puntos'
    change_text: '0'
    change_color: (1,1,1,1)
    is_user: False

    canvas.before:
        Color:
            rgba: utils.get_color_from_hex('#e8f5e9') if root.is_user else (1,1,1,1)
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [dp(20)]
            
    Label:
        text: root.rank_text
        font_size: '16sp'
        bold: True
        color: .3,.3,.3,1
        size_hint_x: None
        width: dp(30)
    
    BoxLayout:
        size_hint_x: None
        width: dp(50)
        canvas.before:
            Color:
                rgba: root.avatar_color
            Ellipse:
                pos: self.center_x - dp(20), self.center_y - dp(20)
                size: dp(40), dp(40)
        Label:
            text: root.avatar_text
            font_size: '18sp'
            color: .5,.5,.5,1

    BoxLayout:
        orientation: 'vertical'
        padding: [dp(5), dp(15)]
        Label:
            text: root.name_text
            font_size: '15sp'
            bold: True
            color: .2,.2,.2,1
            halign: 'left'
            text_size: self.width, None
        Label:
            text: root.points_text
            font_size: '13sp'
            color: .6,.6,.6,1
            halign: 'left'
            text_size: self.width, None
            
    BoxLayout:
        size_hint_x: None
        width: dp(50)
        Label:
            text: root.change_text
            color: root.change_color
            font_size: '13sp'

# --- Pestaña de Logros ---
<AchievementsContentScreen@Screen>:
    name: 'logros_tab'
    ScrollView:
        bar_width: 0
        GridLayout:
            cols:1
            size_hint_y: None
            height: self.minimum_height
            padding: [dp(15), dp(15), dp(15), dp(100)]
            spacing: dp(15)

            # Tarjeta de Progreso General
            BoxLayout:
                size_hint_y: None
                height: dp(100)
                padding: dp(20)
                canvas.before:
                    Color:
                        rgba: 1,1,1,1
                    RoundedRectangle:
                        pos: self.pos
                        size: self.size
                        radius: [dp(20)]
                
                MDIcon:
                    icon: 'star'
                    theme_text_color: "Custom"
                    text_color: utils.get_color_from_hex('#4caf50')
                    font_size: '24sp'
                    size_hint_x: None
                    width: dp(40)
                    pos_hint: {'center_y': .5}
                    halign: "center"

                BoxLayout:
                    orientation: 'vertical'
                    Label:
                        text: 'Progreso General'
                        font_size: '16sp'
                        bold: True
                        color: .2,.2,.2,1
                        halign: 'left'
                        text_size: self.width, None
                    BoxLayout:
                        padding: [0, dp(10), 0, 0]
                        Label:
                            text: '[b]3[/b]\nLogros Desbloqueados'
                            markup: True
                            color: .4,.4,.4,1
                            halign: 'left'
                            text_size: self.width, None
                        Label:
                            text: '[b]3[/b]\nPor Desbloquear'
                            markup: True
                            color: .4,.4,.4,1
                            halign: 'left'
                            text_size: self.width, None
            
            # Lista de Logros
            AchievementItem:
                icon_text: 'sprout'
                title_text: 'Primer Paso'
                rarity_text: 'común'
                rarity_color: utils.get_color_from_hex('#9e9e9e')
                description_text: 'Recicla tu primer elemento'
                points_text: '+50 puntos'
                date_text: '· 2024-03-15'
                locked: False

            AchievementItem:
                icon_text: 'recycle'
                title_text: 'Eco Warrior'
                rarity_text: 'raro'
                rarity_color: utils.get_color_from_hex('#2196f3')
                description_text: 'Recicla 50 elementos'
                points_text: '+200 puntos'
                date_text: '· 2024-04-01'
                locked: False
            
            AchievementItem:
                icon_text: 'lock'
                title_text: 'Green Champion'
                rarity_text: 'épico'
                rarity_color: utils.get_color_from_hex('#9c27b0')
                description_text: 'Recicla 100 elementos'
                points_text: ''
                date_text: ''
                locked: True

# --- Pestaña de Ranking ---
<RankingContentScreen@Screen>:
    name: 'ranking_tab'
    ScrollView:
        bar_width: 0
        GridLayout:
            cols:1
            size_hint_y: None
            height: self.minimum_height
            padding: [dp(15), dp(15), dp(15), dp(100)]
            spacing: dp(15)

            # Tarjeta de "Tu Posición"
            BoxLayout:
                size_hint_y: None
                height: dp(80)
                padding: dp(20)
                canvas.before:
                    Color:
                        rgba: 1,1,1,1
                    RoundedRectangle:
                        pos: self.pos
                        size: self.size
                        radius: [dp(20)]
                BoxLayout:
                    size_hint_x: None
                    width: dp(50)
                    canvas.before:
                        Color:
                            rgba: utils.get_color_from_hex('#e8f5e9')
                        Ellipse:
                            pos: self.center_x - dp(20), self.center_y - dp(20)
                            size: dp(40), dp(40)
                    MDIcon:
                        icon: 'trophy'
                        theme_text_color: "Custom"
                        text_color: utils.get_color_from_hex('#4caf50')
                        font_size: '24sp'
                        pos_hint: {'center_x': .5, 'center_y': .5}
                        halign: "center"
                BoxLayout:
                    orientation: 'vertical'
                    Label:
                        text: 'Tu Posición'
                        font_size: '16sp'
                        bold: True
                        color: .2,.2,.2,1
                        halign: 'left'
                        text_size: self.width, None
                    Label:
                        text: 'Ranking Global'
                        font_size: '13sp'
                        color: .6,.6,.6,1
                        halign: 'left'
                        text_size: self.width, None
                BoxLayout:
                    orientation: 'vertical'
                    size_hint_x: None
                    width: dp(80)
                    Label:
                        text: '#3'
                        font_size: '22sp'
                        bold: True
                        color: .2,.2,.2,1
                        halign: 'right'
                        text_size: self.width, None
                    Label:
                        text: '2,850 pts'
                        font_size: '13sp'
                        color: .6,.6,.6,1
                        halign: 'right'
                        text_size: self.width, None

            # Título "Top Recicladores"
            Label:
                text: 'Top Recicladores'
                font_size: '16sp'
                bold: True
                color: .2,.2,.2,1
                halign: 'left'
                text_size: self.width, None
                size_hint_y: None
                height: dp(30)
                padding: [0, dp(10)]

            # Lista de Ranking
            RankingItem:
                rank_text: '1'
                avatar_text: 'A'
                avatar_color: utils.get_color_from_hex('#fff3e0')
                name_text: 'Ana López'
                points_text: '3,450 puntos'
                change_text: '▲ +2'
                change_color: utils.get_color_from_hex('#4caf50')
                is_user: False
            
            RankingItem:
                rank_text: '2'
                avatar_text: 'C'
                avatar_color: utils.get_color_from_hex('#e3f2fd')
                name_text: 'Carlos Ruiz'
                points_text: '3,200 puntos'
                change_text: '▲ +2'
                change_color: utils.get_color_from_hex('#4caf50')
                is_user: False
            
            RankingItem:
                rank_text: '3'
                avatar_text: 'M'
                avatar_color: utils.get_color_from_hex('#fff3e0')
                name_text: 'María González (Tú)'
                points_text: '2,850 puntos'
                change_text: '▬'
                change_color: (.6,.6,.6,1)
                is_user: True

            RankingItem:
                rank_text: '4'
                avatar_text: 'P'
                avatar_color: utils.get_color_from_hex('#e3f2fd')
                name_text: 'Pedro Silva'
                points_text: '2,600 puntos'
                change_text: '▼ -1'
                change_color: utils.get_color_from_hex('#f44336')
                is_user: False

# --- Pantalla Principal de Logros ---
<AchievementsScreen>:
    BoxLayout:
        orientation: 'vertical'
        canvas.before:
            Color:
                rgba: utils.get_color_from_hex('#f7f7f7')
            Rectangle:
                pos: self.pos
                size: self.size
        
        # Cabecera de Logros
        BoxLayout:
            orientation: 'vertical'
            size_hint_y: None
            height: dp(140)
            padding: [dp(20), dp(10)]
            canvas.before:
                Color:
                    rgba: utils.get_color_from_hex('#4caf50')
                RoundedRectangle:
                    pos: self.pos
                    size: self.size
                    radius: [0, 0, dp(30), dp(30)]

            BoxLayout:
                size_hint_y: None
                height: dp(40)
                MDIconButton:
                    icon: 'arrow-left'
                    theme_text_color: "Custom"
                    text_color: 1, 1, 1, 1
                    pos_hint: {'center_y': .5}
                    on_release: root.volver_home()
                Label:
                    text: 'Logros y Ranking'
                    font_size: '20sp'
                    bold: True
                    halign: 'center'
                    text_size: self.width, None
                    color: 1, 1, 1, 1
                Widget:
                    size_hint_x: None
                    width: dp(40)

            BoxLayout:
                padding: [0, dp(10), 0, 0]
                MDIcon:
                    icon: 'trophy'
                    theme_text_color: "Custom"
                    text_color: 1, 1, 1, 1
                    font_size: '24sp'
                    size_hint_x: None
                    width: dp(50)
                    pos_hint: {'center_y': .5}
                    halign: "center"
                BoxLayout:
                    orientation: 'vertical'
                    Label:
                        text: 'Nivel Eco Warrior'
                        font_size: '18sp'
                        bold: True
                        halign: 'left'
                        text_size: self.width, None
                        color: 1, 1, 1, 1
                    Label:
                        text: '2,850 puntos totales'
                        font_size: '14sp'
                        color: .9,.9,.9,1
                        halign: 'left'
                        text_size: self.width, None
                Button:
                    text: 'Rango #3'
                    size_hint: None, None
                    size: dp(90), dp(35)
                    background_color: 0,0,0,0
                    color: 1, 1, 1, 1
                    canvas.before:
                        Color:
                            rgba: 1,1,1,0.3
                        RoundedRectangle:
                            pos: self.pos
                            size: self.size
                            radius: [dp(17)]
        
        # Pestañas de Logros / Ranking
        BoxLayout:
            size_hint_y: None
            height: dp(60)
            padding: [dp(15), dp(10)]
            spacing: dp(10)
            ToggleButton:
                text: 'Logros'
                group: 'achievements_tabs'
                state: 'down'
                background_color: 0,0,0,0
                canvas.before:
                    Color:
                        rgba: utils.get_color_from_hex('#4caf50') if self.state == 'down' else utils.get_color_from_hex('#eeeeee')
                    RoundedRectangle:
                        pos: self.pos
                        size: self.size
                        radius: [dp(20)]
                color: (1,1,1,1) if self.state == 'down' else (0.5, 0.5, 0.5, 1)
                on_press: achievements_tabs.current = 'logros_tab'
            ToggleButton:
                text: 'Ranking'
                group: 'achievements_tabs'
                background_color: 0,0,0,0
                canvas.before:
                    Color:
                        rgba: utils.get_color_from_hex('#4caf50') if self.state == 'down' else utils.get_color_from_hex('#eeeeee')
                    RoundedRectangle:
                        pos: self.pos
                        size: self.size
                        radius: [dp(20)]
                color: (1,1,1,1) if self.state == 'down' else (0.5, 0.5, 0.5, 1)
                on_press: achievements_tabs.current = 'ranking_tab'

        # ScreenManager para el contenido de las pestañas
        ScreenManager:
            id: achievements_tabs
            transition: NoTransition()
            AchievementsContentScreen:
            RankingContentScreen:

