#:kivy 2.3.1

# TEMPLATE - Diseño de pantalla
# Copia este archivo y renómbralo siguiendo el patrón: nombre_screen.kv

<TEMPLATEScreen>:
    MDBoxLayout:
        orientation: 'vertical'
        md_bg_color: app.theme_cls.backgroundColor
        
        # AppBar superior
        MDTopAppBar:
            title: "Título de la Pantalla"
            elevation: 2
            md_bg_color: app.theme_cls.primary_color
            left_action_items: [["menu", lambda x: None]]
            right_action_items: [["dots-vertical", lambda x: None]]
        
        # Contenido principal
        ScrollView:
            MDBoxLayout:
                orientation: 'vertical'
                padding: dp(20)
                spacing: dp(20)
                adaptive_height: True
                
                # Ejemplo de tarjeta
                MDCard:
                    orientation: 'vertical'
                    padding: dp(20)
                    spacing: dp(10)
                    size_hint_y: None
                    height: dp(150)
                    elevation: 2
                    
                    MDLabel:
                        text: "Título de la Tarjeta"
                        font_style: "H6"
                        theme_text_color: "Primary"
                    
                    MDLabel:
                        text: "Contenido de la tarjeta"
                        theme_text_color: "Secondary"
                    
                    MDRaisedButton:
                        text: "Acción"
                        pos_hint: {"center_x": 0.5}
                        on_release: root.example_method()

