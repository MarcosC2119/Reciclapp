#:kivy 2.3.1
#:import utils kivy.utils
#:import MDIconButton kivymd.uix.button.MDIconButton
#:import MDIcon kivymd.uix.label.MDIcon
#:import MDBoxLayout kivymd.uix.boxlayout.MDBoxLayout
#:import MDLabel kivymd.uix.label.MDLabel
#:import MDTextField kivymd.uix.textfield.MDTextField
#:import MDCard kivymd.uix.card.MDCard

<PostItem@MDCard>:
    orientation: 'vertical'
    size_hint_y: None
    height: self.minimum_height
    padding: dp(15)
    spacing: dp(10)
    radius: [dp(20)]
    elevation: 1
    md_bg_color: 1, 1, 1, 1
    
    # Cabecera del post
    BoxLayout:
        size_hint_y: None
        height: dp(40)
        spacing: dp(10)
        
        MDIcon:
            icon: "account-circle"
            theme_text_color: "Custom"
            text_color: utils.get_color_from_hex('#bdbdbd')
            font_size: "40sp"
            size_hint: None, None
            size: dp(40), dp(40)
            pos_hint: {'center_y': .5}

        BoxLayout:
            orientation: 'vertical'
            Label:
                text: root.author_name
                font_size: '14sp'
                bold: True
                color: .2,.2,.2,1
                halign: 'left'
                text_size: self.size
                valign: 'bottom'
            Label:
                text: root.time_text
                font_size: '12sp'
                color: .6,.6,.6,1
                halign: 'left'
                text_size: self.size
                valign: 'top'

    # Contenido del post
    Label:
        text: root.content_text
        color: .3,.3,.3,1
        size_hint_y: None
        height: self.texture_size[1]
        text_size: self.width, None
        halign: 'left'
    
    # Pie de post
    BoxLayout:
        size_hint_y: None
        height: dp(30)
        spacing: dp(20)
        
        BoxLayout:
            size_hint_x: None
            width: dp(60)
            spacing: dp(5)
            MDIcon:
                icon: "heart-outline"
                theme_text_color: "Custom"
                text_color: .5,.5,.5,1
                font_size: "18sp"
                pos_hint: {'center_y': .5}
            Label:
                text: root.likes_count
                color: .5,.5,.5,1
                font_size: "12sp"
        
        BoxLayout:
            size_hint_x: None
            width: dp(60)
            spacing: dp(5)
            MDIcon:
                icon: "comment-outline"
                theme_text_color: "Custom"
                text_color: .5,.5,.5,1
                font_size: "18sp"
                pos_hint: {'center_y': .5}
            Label:
                text: root.comments_count
                color: .5,.5,.5,1
                font_size: "12sp"
                
        Widget:


<CommunityScreen>:
    BoxLayout:
        orientation: 'vertical'
        canvas.before:
            Color:
                rgba: utils.get_color_from_hex('#f7f7f7')
            Rectangle:
                pos: self.pos
                size: self.size
        
        # Cabecera de Comunidad
        BoxLayout:
            orientation: 'vertical'
            size_hint_y: None
            height: dp(180)
            canvas.before:
                Color:
                    rgba: utils.get_color_from_hex('#4caf50')
                RoundedRectangle:
                    pos: self.pos
                    size: self.size
                    radius: [0, 0, dp(30), dp(30)]
            
            BoxLayout:
                padding: [dp(20), dp(10)]
                Label:
                    text: 'Comunidad'
                    font_size: '24sp'
                    bold: True
                    halign: 'left'
                    text_size: self.size
                    color: 1, 1, 1, 1
                
                MDIconButton:
                    icon: "magnify"
                    theme_text_color: "Custom"
                    text_color: 1, 1, 1, 1
                    pos_hint: {'center_y': .5}

            GridLayout:
                cols: 3
                padding: [dp(20), dp(10), dp(20), dp(20)]
                BoxLayout:
                    orientation: 'vertical'
                    Label:
                        text: '156'
                        font_size: '22sp'
                        bold: True
                        color: 1, 1, 1, 1
                    Label:
                        text: 'Amigos'
                        font_size: '13sp'
                        color: .9,.9,.9,1
                BoxLayout:
                    orientation: 'vertical'
                    Label:
                        text: '3'
                        font_size: '22sp'
                        bold: True
                        color: 1, 1, 1, 1
                    Label:
                        text: 'Grupos'
                        font_size: '13sp'
                        color: .9,.9,.9,1
                BoxLayout:
                    orientation: 'vertical'
                    Label:
                        text: '12'
                        font_size: '22sp'
                        bold: True
                        color: 1, 1, 1, 1
                    Label:
                        text: 'Días racha'
                        font_size: '13sp'
                        color: .9,.9,.9,1

        # ScrollView para el contenido principal
        ScrollView:
            bar_width: 0
            GridLayout:
                cols:1
                size_hint_y: None
                height: self.minimum_height
                padding: [dp(15), dp(15), dp(15), dp(100)]
                spacing: dp(15)

                # Pestañas
                BoxLayout:
                    size_hint_y: None
                    height: dp(40)
                    spacing: dp(10)
                    Button:
                        text: "Feed"
                        background_color: 0,0,0,0
                        canvas.before:
                            Color:
                                rgba: utils.get_color_from_hex('#4caf50')
                            RoundedRectangle:
                                pos: self.pos
                                size: self.size
                                radius: [dp(20)]
                        color: 1,1,1,1
                    Button:
                        text: "Grupos"
                        background_color: 0,0,0,0
                        canvas.before:
                            Color:
                                rgba: 1,1,1,1
                            RoundedRectangle:
                                pos: self.pos
                                size: self.size
                                radius: [dp(20)]
                        color: .5,.5,.5,1
                    Button:
                        text: "Retos"
                        background_color: 0,0,0,0
                        canvas.before:
                            Color:
                                rgba: 1,1,1,1
                            RoundedRectangle:
                                pos: self.pos
                                size: self.size
                                radius: [dp(20)]
                        color: .5,.5,.5,1
                
                # Caja para publicar
                BoxLayout:
                    size_hint_y: None
                    height: dp(60)
                    padding: [dp(10), dp(5)]
                    spacing: dp(10)
                    canvas.before:
                        Color:
                            rgba: 1,1,1,1
                        RoundedRectangle:
                            pos: self.pos
                            size: self.size
                            radius: [dp(25)]
                    
                    MDIcon:
                        icon: "account-circle"
                        theme_text_color: "Custom"
                        text_color: utils.get_color_from_hex('#bdbdbd')
                        font_size: "32sp"
                        pos_hint: {'center_y': .5}
                        
                    TextInput:
                        id: post_input
                        hint_text: '¿Qué reciclaste hoy?'
                        background_color: 1,1,1,0
                        cursor_color: 0,0,0,1
                        foreground_color: 0.3, 0.3, 0.3, 1
                        padding: [dp(10), self.height / 2.0 - (self.line_height / 2.0)]
                        multiline: False
                        
                    MDIconButton:
                        icon: "send"
                        theme_text_color: "Custom"
                        text_color: utils.get_color_from_hex('#4caf50')
                        pos_hint: {'center_y': .5}
                        on_release: root.publicar_post()

                # Contenedor del Feed
                GridLayout:
                    id: feed_container
                    cols: 1
                    size_hint_y: None
                    height: self.minimum_height
                    spacing: dp(15)
